/target/
# Installed binary (scripts/install.sh) and release packages (scripts/release.sh).
/bin/
/dist/
node_modules/
references/*
!references/REFERENCES.md
# Personal state and operator settings: kept on the operator's machine, never published.
# Committed examples: data/config.example.json, data/profile.example.md,
# data/local-rules.example.md, data/persona.example.md.
data/config.json
data/profile.md
data/profile/
data/submissions.json
data/local-rules.md
data/persona.md
data/trash/
data/archive/
data/*.lock
# Atomic-save temp files (`.registry-<pid>.json`, `.submissions-<pid>.json`) a crash can leave behind.
data/.*.json
data/registry.json
data/main-system.md
data/main-start.md
data/logs/
BOARD.md
.BOARD-*.md
