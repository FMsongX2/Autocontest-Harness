{"sql":"SELECT C.cl_srl, C.cl_type, C.cl_cate, C.mb_id, C.cl_name, C.cl_title, C.cl_host, C.cl_start_date, C.cl_end_date, C.cl_target,\n                C.cl_status, C.cl_dday, C.cl_reg_date, A.ad_srl, C.cl_update,\n\t\t\t\t\t\t\t\t(SELECT SUM(cv_visit) FROM a2_contest_visit WHERE cl_srl = C.cl_srl) AS cl_view\n            FROM a2_ad_list A LEFT JOIN a2_contest_list C\n                ON A.cl_srl = C.cl_srl\n            WHERE C.cl_status > 0 AND C.cl_disp = 1 AND C.cl_type IN (1,3) AND C.cl_reserve_date < '2026-10-15 15:53:44' \/*AND A.ad_status = 2*\/ AND A.ad_code = 'BOT'\n            AND A.ad_st < '2026-10-15 15:53:44' AND A.ad_et > '2026-10-15 15:53:44'  AND (FIND_IN_SET(1, REPLACE(C.cl_target, ' ', '')) > 0 OR FIND_IN_SET(2, REPLACE(C.cl_target, ' ', '')) > 0 OR FIND_IN_SET(3, REPLACE(C.cl_target, ' ', '')) > 0 OR FIND_IN_SET(4, REPLACE(C.cl_target, ' ', '')) > 0 OR FIND_IN_SET(8, REPLACE(C.cl_target, ' ', '')) > 0 OR FIND_IN_SET(9, REPLACE(C.cl_target, ' ', '')) > 0)  order by A.ad_order asc, A.ad_et desc","currentPage":1,"totalPage":22,"totalCount":233,"perPage":10,"rows":[{"cl_srl":"543498","cl_cate":"<span class=\"badge cl_cate\">\uc0ac\uc9c4\u00b7\uc601\uc0c1<\/span><span class=\"badge cl_cate\">\uc81c\ud55c\uc5c6\uc74c<\/span>","cl_status":"<span class='badge cl_status2'>\uc811\uc218\uc911<\/span><br>D-33","cl_view":"1354","cl_title":"<a href='\/hit\/contest\/4564?page=1&sortname=cl_order&sortorder=asc&t=1&ct=&sc=&tg='>[29\uc5ed\uc20f\ud3fc\uc655] \uc81c1\ud68c \uc778\uc2a4\ud0c1\uc2a4 \uc601\ud654\uc81c<\/a>","cl_date":"26.10.08~26.11.17","cl_host":"\ud55c\uad6d\ud6c4\uc9c0\ud544\ub984, \ud55c\uad6d\uacbd\uc81c\u2026","cl_is_star":"1"},{"cl_srl":"542723","cl_cate":"<span class=\"badge cl_cate\">\uc0ac\uc9c4\u00b7\uc601\uc0c1<\/span><span class=\"badge cl_cate\">\uc77c\ubc18\uc778<\/span><span class=\"badge cl_cate\">\ub300\ud559\uc0dd<\/span><span class=\"badge cl_cate\">\ub300\ud559\uc6d0\uc0dd<\/span>","cl_status":"<span class='badge cl_status2'>\uc811\